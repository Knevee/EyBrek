# =====================================================================
# EyBrek - Configuracion del servidor
# Copie este archivo como .env y ajuste los valores.
# =====================================================================

# Puerto donde escucha el servidor de EyBrek
PUERTO=3000

# ---------------------------------------------------------------------
# Motor de base de datos
# ---------------------------------------------------------------------
# sqlite (por defecto): la base es un archivo que se crea solo.
#   No necesita MySQL, ni usuario, ni contrasena.
# mysql: base de datos central (por ejemplo, la compartida por el equipo).
#   Hay que tener MySQL Server instalado y la base 'eybrek' creada.
DB_MOTOR=sqlite

# Ruta del archivo de la base (solo para SQLite).
# Si se deja vacio, se usa server/datos/eybrek.db
# DB_RUTA=

# ---------------------------------------------------------------------
# Solo si DB_MOTOR=mysql
# ---------------------------------------------------------------------
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=eybrek
# DB_PASSWORD=CAMBIAR_ESTA_CLAVE
# DB_NAME=eybrek

# Rondas de hash para las contrasenas (RNF-02)
BCRYPT_ROUNDS=10
